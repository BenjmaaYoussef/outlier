# Copy this file to .env.local and fill in the keys:  cp .env.example .env.local
# Never commit .env.local.

# --- MarioBot on the Genesis server (OpenAI-compatible) ---
GENESIS_BASE_URL=https://gas.copycoders.ai/api/v1
GENESIS_API_KEY=
MARIO_SLUG=mario-bot-

# --- OpenRouter ---
# Genesis also needs this key as the model provider key (sent as X-Provider-Key),
# and the app uses it for the vision model that reads on-screen hooks.
OPENROUTER_API_KEY=
VISION_MODEL=google/gemini-3.8-flash

# --- ScrapeCreators ---
# Turns an Instagram link into caption, views, video, transcript and the creator's baseline.
SCRAPECREATORS_API_KEY=
